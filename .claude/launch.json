{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": ["jobagency.api:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": "venv/bin/streamlit",
      "runtimeArgs": ["run", "jobagency/ui.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
